{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skvn-marine/product-category-grid",
  "version": "1.3.20",
  "title": "SKVN Product Category Grid",
  "category": "skvn-marine",
  "icon": "category",
  "description": "Dynamic grid of WooCommerce product categories with shared category details.",
  "textdomain": "skvn-marine-blocks",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "columnsDesktop": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 2
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "gap": {
      "type": "string",
      "default": "medium"
    },
    "mediaFit": {
      "type": "string",
      "default": "contain"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "showName": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": false
    },
    "showPath": {
      "type": "boolean",
      "default": false
    },
    "showCount": {
      "type": "boolean",
      "default": false
    },
    "showCta": {
      "type": "boolean",
      "default": false
    },
    "ctaLabel": {
      "type": "string",
      "default": "Explore category"
    },
    "cardBackground": {
      "type": "string",
      "default": ""
    },
    "cardRadius": {
      "type": "string",
      "default": "md"
    },
    "cardPadding": {
      "type": "string",
      "default": "md"
    },
    "cardShadow": {
      "type": "string",
      "default": "soft"
    },
    "nameColor": {
      "type": "string",
      "default": ""
    },
    "nameFontFamily": {
      "type": "string",
      "default": ""
    },
    "nameFontSize": {
      "type": "string",
      "default": ""
    },
    "detailsColor": {
      "type": "string",
      "default": ""
    },
    "detailsFontSize": {
      "type": "string",
      "default": ""
    },
    "actionBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "actionTextColor": {
      "type": "string",
      "default": ""
    },
    "actionHoverBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "actionHoverTextColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  }
}